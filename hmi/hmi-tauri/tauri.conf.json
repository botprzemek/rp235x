{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rp235x-hmi",
  "version": "0.1.0",
  "identifier": "github.botprzemek.rp235x.hmi",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "rp235x-hmi",
        "width": 1060,
        "height": 680,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 0
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
